{
	"mode": "browser",
	"block": {
		"controls": [
			{
				"id": "level",
				"label": "레벨",
				"hint": "군중이 있는 곳: 집 뒤로 골목이 있는 장터, 성벽까지 이어지는 경사로가 있는 성, 또는 길이 여러 갈래인 생울타리 미로.",
				"type": "choice",
				"options": [
					{
						"value": "market",
						"label": "장터",
						"image": "thumbs/levels/market.webp"
					},
					{
						"value": "castle",
						"label": "성벽",
						"image": "thumbs/levels/castle.webp"
					},
					{
						"value": "maze",
						"label": "생울타리 미로",
						"image": "thumbs/levels/maze.webp"
					}
				],
				"default": "market",
				"essential": true
			},
			{
				"id": "crowd",
				"label": "군중 규모",
				"hint": "레벨 위에 있는 사람 수.",
				"type": "number",
				"min": 10,
				"max": 200,
				"step": 5,
				"default": 70,
				"essential": true
			},
			{
				"id": "speed",
				"label": "속도",
				"hint": "보냈을 때 가는 속도: 낮은 쪽은 빠른 걸음, 높은 쪽은 전력 질주.",
				"type": "number",
				"min": 1,
				"max": 6,
				"step": 0.1,
				"default": 2.8,
				"unit": "m/s",
				"essential": true
			},
			{
				"id": "walkable",
				"label": "걸을 수 있는 영역 표시",
				"hint": "내비메시를 그립니다: Recast가 레벨에서 계산해 낸 바닥으로, 블록을 놓으면 그 주변을 다시 깎습니다.",
				"type": "toggle",
				"default": false,
				"essential": true
			},
			{
				"id": "spacing",
				"label": "개인 공간",
				"hint": "사람들이 서로 얼마나 거리를 두는지. 0이면 스쳐 지나가고, 4면 서로 넉넉히 비켜 줍니다.",
				"type": "number",
				"min": 0,
				"max": 4,
				"step": 0.1,
				"default": 2
			},
			{
				"id": "wander",
				"label": "어슬렁거리기",
				"hint": "사람들이 스스로 돌아다니는지 여부: 누군가 보내기 전까지 레벨을 돌아다니고, 도착하고 몇 초 뒤에는 산책을 나갑니다. 끄면 가만히 서 있습니다.",
				"type": "toggle",
				"default": true
			}
		],
		"presets": [],
		"triggers": [
			{
				"id": "scatter",
				"label": "흩어지기",
				"hint": "모두가 각자 어딘가로 달려갑니다."
			},
			{
				"id": "clear",
				"label": "블록 치우기",
				"hint": "놓았던 돌 블록을 모두 치우고, 군중이 그 길을 다시 쓸 수 있게 합니다."
			}
		]
	},
